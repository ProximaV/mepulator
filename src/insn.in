0001_nnnn_mmmm_1000
div {
	int32_t lhs = static_cast<int32_t>(GR(n));
	int32_t rhs = static_cast<int32_t>(GR(m));
	if (rhs == 0) {
		CRN(lo) = 0;
		CRN(hi) = 0;
	} else if (lhs == INT32_MIN && rhs == -1) {
		CRN(lo) = static_cast<uint32_t>(INT32_MIN);
		CRN(hi) = 0;
	} else {
		CRN(lo) = static_cast<uint32_t>(lhs / rhs);
		CRN(hi) = static_cast<uint32_t>(lhs % rhs);
	}
}


